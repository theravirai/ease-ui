{
    "extends": "./tsconfig.app.json",
    "compilerOptions": {
      "declaration": true,
      "emitDeclarationOnly": true,
      "outDir": "dist/types",
      "noEmit": false,
      "declarationMap": true,
      "allowImportingTsExtensions": false,
      "stripInternal": true,
      "skipLibCheck": true
    },
    "include": [
      "src/index.ts",
      "src/components/**/*",
      "src/libs/**/*"
    ]
  }
  